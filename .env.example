MMS_SECRET_KEY=replace-with-a-long-random-secret
MMS_DEBUG=0
MMS_ALLOWED_HOSTS=yqnus.com,www.yqnus.com,.vercel.app
MMS_CSRF_TRUSTED_ORIGINS=https://yqnus.com,https://www.yqnus.com,https://*.vercel.app
MMS_SECURE_SSL_REDIRECT=1
MMS_SECURE_HSTS_SECONDS=3600

# Supabase Database: each Vercel request uses the transaction pooler (normally port 6543).
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
MMS_DATABASE_POOL_MODE=transaction

# Supabase Storage S3 credentials. Keep the bucket private.
MMS_STORAGE_BACKEND=supabase
MMS_STORAGE_PREFIX=media
AWS_ACCESS_KEY_ID=replace-with-supabase-s3-access-key
AWS_SECRET_ACCESS_KEY=replace-with-supabase-s3-secret-key
AWS_STORAGE_BUCKET_NAME=mms-media
AWS_S3_ENDPOINT_URL=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
AWS_S3_REGION_NAME=REGION

# Vercel Cron sends this value as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=replace-with-a-separate-long-random-secret
MMS_CRON_MAX_OCCURRENCES=100
MMS_LOCAL_SCHEDULER=0

MMS_FROM_EMAIL=mms@yqnus.com
